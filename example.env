# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-***

# ---------------------------------------------------------------------------
# JWT verification for AgentOS. Generate your JWT_VERIFICATION_KEY at os.agno.com.
# In production (RUNTIME_ENV != dev), the app refuses to serve traffic without
# JWT_VERIFICATION_KEY or JWT_JWKS_FILE. Local dev (RUNTIME_ENV=dev) is ok without it.
# Set `authorization=False` in app/main.py to opt out (not recommended).
# ---------------------------------------------------------------------------
# Quote the value so parsers read the multi-line PEM as one variable:
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json

# ---------------------------------------------------------------------------
# AgentOS URL used by the scheduler and MCP server.
# Set this to the public URL of your AgentOS instance.
# ---------------------------------------------------------------------------
# AGENTOS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# MCP OAuth — set MCP_CONNECT_SECRET to turn the /mcp endpoint into its own
# OAuth 2.1 authorization server, which is how claude.ai and ChatGPT (web) connect.
# Connecting to the MCP server asks for this secret on a consent page.
# Generate a strong one (≥16 chars):
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
# MCP_CONNECT_SECRET=

# Optional: pin the OAuth token signing key (≥32 chars). Unset, a strong key is
# generated and persisted in the database. Rotating it invalidates outstanding tokens.
# AGENTOS_MCP_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Agno's and the Studio registry's web search tools use the Parallel SDK
# when authenticated, and fall back to Parallel's keyless MCP server otherwise.
# ---------------------------------------------------------------------------
# PARALLEL_API_KEY=

# ---------------------------------------------------------------------------
# Schedules
# ---------------------------------------------------------------------------
# ENABLE_DEPLOY_CHECK=True
# EVALS_TAG=smoke
# EVALS_CASE_TIMEOUT_SECONDS=90
# EVALS_SUITE_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Slack — set both to enable the Slack interface.
#   SLACK_BOT_TOKEN       Bot User OAuth Token (xoxb-***)
#   SLACK_SIGNING_SECRET  Signing Secret (Basic Information → App Credentials)
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Local development
#
# compose.yaml sets both for the local stack, so they are only needed in a file
# you carry elsewhere — README's Railway path copies this file to
# .env.production, where nothing sets them for you.
#   AGNO_DEBUG   True turns on agno's verbose debug logging.
#   WAIT_FOR_DB  True blocks the entrypoint on Postgres before serving.
# ---------------------------------------------------------------------------
# AGNO_DEBUG=False
# WAIT_FOR_DB=False

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg
