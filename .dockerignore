.DS_Store

.git

# Cache
.mypy_cache
.ruff_cache
.pytest_cache
**/__pycache__
*.egg-info
**/*.pyc

# Machine specific
.idea
.vscode

# Ignore .env files
.env
.env.*
.envrc

# ignore virtualenvs
.venv
venv*
aienv*

.ipynb_checkpoints

# Project-specific. .claude/ and .codex/ are per-machine coding-agent state:
# both are gitignored, but docker reads this file independently of .gitignore,
# so a directory left off here still rides into the build context and out to the
# registry. The shared, vendor-neutral assets live in .agents/skills/ — those
# ship, because Platform Engineer reads them out of the deployed image.
tmp/
.claude/
.codex/

# Node (local deploy-tooling installs — not part of the image)
node_modules
package.json
package-lock.json
